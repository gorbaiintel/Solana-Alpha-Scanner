NODE_ENV=production

# Solana Mainnet RPC & WebSocket (QuickNode / Helius / Triton / Public)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com/

# BNB Smart Chain Mainnet RPC & WebSocket
BNB_RPC_URL=https://bsc-dataseed.binance.com/
BNB_WS_URL=wss://bsc-ws-node.nariox.org:443

# Database & Cache (PostgreSQL + TimescaleDB, Redis)
DATABASE_URL=
REDIS_URL=

# Jupiter DEX Aggregator API (Solana)
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Execution & Bot Safety Controls
# EXECUTION_MODE: PAPER or LIVE (Default: PAPER for tests only; in LIVE, sends real on-chain transactions)
EXECUTION_MODE=PAPER
AUTOTRADE_ENABLED=false

# Risk Limits
MAX_POSITION_USD=1000
MAX_DAILY_LOSS_USD=250
MAX_OPEN_POSITIONS=5
MAX_SLIPPAGE_BPS=150
MAX_PRICE_IMPACT_BPS=250
MIN_LIQUIDITY_USD=5000

# FLAP Adapter (BNB Smart Chain) - Set address/ABI if available, otherwise marked FLAP_ADAPTER_NOT_CONFIGURED
FLAP_FACTORY_ADDRESS=
FLAP_ROUTER_ADDRESS=
FLAP_POOL_FACTORY_ADDRESS=
FLAP_EVENT_TOPICS=

# Optional AI Analysis
GEMINI_API_KEY=
